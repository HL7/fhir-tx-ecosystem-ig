{
  "resourceType": "Parameters",
  "parameter": [
    {
      "name": "valueSet",
      "resource": {
        "resourceType": "ValueSet",
        "url": "http://hl7.org/fhir/test/ValueSet/sct-ecl-description-filter-wild-any",
        "version": "5.0.0",
        "status": "active",
        "experimental": false,
        "date": "2026-10-25",
        "publisher": "FHIR Project",
        "description": "A wildcard term of only asterisks matches every description, so the filter changes nothing.",
        "compose": {
          "include": [
            {
              "system": "http://snomed.info/sct",
              "version": "http://snomed.info/xsct/31000003106/version/20250909",
              "filter": [
                {
                  "property": "constraint",
                  "op": "=",
                  "value": "<! 10200004 |Liver structure| {{ D term = wild:\"**\" }}"
                }
              ]
            }
          ]
        }
      }
    }
  ]
}
