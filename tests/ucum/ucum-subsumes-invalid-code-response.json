{
  "resourceType" : "OperationOutcome",
  "issue" : [{
    "$optional-properties$" : ["expression", "diagnostics"],
    "extension" : [{
      "$optional$" : "!tx.fhir.org",
      "url" : "http://hl7.org/fhir/StructureDefinition/operationoutcome-message-id",
      "valueString" : "$choice:Unknown_Code_in_Version|Unknown_Code_in$"
    }],
    "severity" : "error",
    "code" : "code-invalid",
    "details" : {
      "coding" : [{
        "system" : "http://hl7.org/fhir/tools/CodeSystem/tx-issue-type",
        "code" : "invalid-code"
      }],
      "fhir_comments" : "the server may also explain what is wrong with the unit in diagnostics",
      "text" : "$fragments:not-a-unit|http://unitsofmeasure.org$"
    },
    "expression" : ["codeA"]
  }]
}
